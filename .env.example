# mcp-drawio-diagram — environment variables
#
# HOW THESE ARE LOADED. This server reads os.environ directly and does NOT load
# a .env file — there is no python-dotenv dependency and no load_dotenv() call
# in the repo. An MCP server receives its environment from the MCP client, so
# these belong in the client config: for Claude Code, ~/.claude/settings.json
# under mcpServers -> drawio-diagram -> env. Copying this to .env has no effect.
#
# Authoritative reference: README.md "Environment Variables".

# DRAWIO_OUTPUT_DIR — optional. Default is `drawio` beneath the project root.
# Precedence in _output_dir(): this variable, then the caller-supplied
# output_dir, then the mandated `drawio` default.
#
# NOTE: this file previously stated the default was `docs/diagrams/`. It is not,
# and never was in this code — server.py resolves `env_dir or output_dir or
# "drawio"`, and README.md documents `drawio/` correctly. The wrong default
# mattered because rules/45 mandates draw.io output at the PROJECT ROOT in
# `drawio/`, so following this file would have put every diagram in the wrong
# place while appearing to follow the documented default.
DRAWIO_OUTPUT_DIR=your_value_here

# DRAWIO_SHARE — optional, default "0". Set to "1" to emit a shareable URL
# alongside generated diagrams. Read at module import in server.py; was
# undocumented here.
DRAWIO_SHARE=0

# DRAWIO_MAX_FILE_SIZE_KB — optional, default "2048". Size ceiling enforced on
# a generated .drawio file before it is written; exceeding it is a hard failure
# rather than a truncation. Read at module import in server.py; was
# undocumented here.
DRAWIO_MAX_FILE_SIZE_KB=2048

# GITHUB_RAW_BASE_URL — NOT IMPLEMENTED. Read by nothing. This file previously
# described it as the "GitHub raw URL base for shareable URL generation", but
# get_shareable_url does not consult it. Kept commented rather than deleted so
# the intent stays visible.
# GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com
